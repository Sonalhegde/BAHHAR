# Google Maps Platform Key (Restrict by Android package name & iOS bundle ID com.bahharai.bahhar)
GOOGLE_MAPS_API_KEY=AIzaSyYourRestrictedGoogleMapsApiKeyHere

# WorldTides Marine API (Proxied through backend service — set this in backend/.env;
# the FastAPI server at backend/main.py is the ONLY consumer, never the Flutter app)
WORLDTIDES_API_KEY=your_worldtides_api_key_here

# Open-Meteo weather & marine APIs are keyless (non-commercial tier) — no key required.

# Internal Python ML Microservice URL
ML_API_BASE_URL=https://ml.bahhar.om/api/v1
ML_API_AUTH_TOKEN=bahhar_ml_secure_service_token

# Firebase Environment Config
FIREBASE_PROJECT_ID=bahhar-ai-prod
FIREBASE_STORAGE_BUCKET=bahhar-ai-prod.appspot.com
