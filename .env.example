# Maps — MapLibre GL + OpenFreeMap vector tiles are keyless (no API key, no billing).
# The former GOOGLE_MAPS_API_KEY was removed with the google_maps_flutter dependency.

# WorldTides Marine API (Proxied through backend service — set this in backend/.env;
# the FastAPI server at backend/main.py is the ONLY consumer, never the Flutter app)
WORLDTIDES_API_KEY=your_worldtides_api_key_here

# AccuWeather (set in backend/.env — the same rule as WorldTides: the key is NEVER shipped
# to the app or embedded in the landing page's client-side JS). Register at
# developer.accuweather.com and confirm the current free-tier ceiling on their pricing page:
# it has been published anywhere from ~50 to ~500 calls/day depending on the package, and it
# is a DAILY ceiling, which is why GET /api/v1/weather caches one entry per region for 30
# minutes and refuses (then degrades to the last good payload) once the day's budget is spent.
# Leave the key unset and the endpoint serves the documented AccuWeather-shaped mock instead
# of failing, so the app can be built against the contract before an account exists.
ACCUWEATHER_API_KEY=
# Calls allowed per day before the endpoint starts serving stale/mock data; 0 = no cap.
ACCUWEATHER_DAILY_CALL_BUDGET=0

# Open-Meteo weather & marine APIs are keyless (non-commercial tier) — no key required.

# Internal Python ML Microservice URL
ML_API_BASE_URL=https://ml.bahhar.om/api/v1
ML_API_TOKEN=bahhar_ml_secure_service_token           # v3 name

# Copernicus Marine (Phase 5 chlorophyll-a / SST fronts) — proxied via backend/.env.
# Not yet provisioned; register at https://data.marine.copernicus.eu/register
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# Firebase Environment Config
# bahar-3719a is the real project ID (the console shows it under the display name "bahar").
# These values are documentary: the Flutter app is configured by the gitignored native files
# (android/app/google-services.json, ios/Runner/GoogleService-Info.plist), not by this file.
FIREBASE_PROJECT_ID=bahar-3719a
# Empty on purpose. Cloud Storage needs the Blaze plan, which this project does not carry, so
# there is no bucket; file storage is Supabase (below) and Firestore holds only metadata.
FIREBASE_STORAGE_BUCKET=

# Supabase Storage — catch/photo files, chosen because Firebase Storage is not free-tier.
# The URL and anon key are public-by-design client config (row-level security is the boundary),
# the same way a Firebase client config is not a secret. Pass them at build time:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY is backend-only — set in backend/.env, never in the app.
