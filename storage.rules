// INACTIVE - deployed nowhere. Firebase Cloud Storage sits behind the Blaze (billing) plan at
// any volume and this project carries no card, so catch photos moved to Supabase Storage
// (lib/core/services/supabase_storage_service.dart). This file is kept, not deleted: if a Blaze
// decision is ever made, the bucket layout and the per-owner isolation below are what returns.
// Until then nothing reads it, and firebase.json referencing it does not change that.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Catch photos are private to their owner. A user may read, upload and
    // overwrite files only under their own /catches/{uid}/ scope. Uploads are
    // size- and type-gated. Deletes are restricted to the owner as well.
    match /catches/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // Max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else in the bucket is closed by default (defence in depth).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
