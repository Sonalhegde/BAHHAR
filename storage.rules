rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Catch photos are private to their owner. A user may read, upload and
    // overwrite files only under their own /catches/{uid}/ scope. Uploads are
    // size- and type-gated. Deletes are restricted to the owner as well.
    match /catches/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // Max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else in the bucket is closed by default (defence in depth).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
