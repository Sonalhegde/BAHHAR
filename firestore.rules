rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User preferences
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Catches: Users can create and manage their own logged catches
    match /catches/{catchId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Trips: Users can create and manage their own trip plans
    match /trips/{tripId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Fisherman profile: the single canonical identity record. Documents Wallet
    // and the Safety Center READ it instead of keeping their own copy of vessel
    // registration, size and seats, so a field can only be edited in one place.
    //
    // The document is FLAT, because that is what FishermanProfileModel.toJson()
    // writes: fullName / civilId / governorate at the top level, and boat, gear,
    // licences, crew and documents as reference ID arrays (vesselIds, gearIds,
    // licenceIds, crewIds, documentIds) rather than nested objects. Asserting a
    // nested {personal, boat, gear} shape here would reject every first save with
    // PERMISSION_DENIED, since no client in this repo has ever written one.
    //
    // Same per-user isolation as catches and trips, plus the uid == document id
    // check so a profile cannot be written into somebody else's slot.
    match /fisherman_profiles/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.data.uid == userId
                   && request.resource.data.keys().hasAll([
                        'fullName', 'licenceIds', 'vesselIds', 'crewIds',
                        'gearIds', 'documentIds'
                      ]);
    }

    // Reference data collections: Read-only for authenticated clients, writable only via Admin/Backend
    match /species/{speciesId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /hotspots/{hotspotId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /regions/{regionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /regulations/{regulationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /restricted_zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /protected_areas/{areaId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Cached marine snapshots: Refreshed only by backend service
    match /marine_conditions/{recordId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /weather/{recordId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Defence in depth: any collection not explicitly opened above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
